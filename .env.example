# Lovable Cloud (Supabase) — frontend environment variables
# These are PUBLIC values (safe to ship in the browser bundle).
# Row Level Security protects your data. NEVER put the service_role key here.

# Your Lovable Cloud project URL
VITE_SUPABASE_URL=

# Your Lovable Cloud publishable / anon key
VITE_SUPABASE_ANON_KEY=

# The app's Supabase client reads this exact variable name.
# Set it to the same publishable/anon value as VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Project ref (optional, used by tooling)
VITE_SUPABASE_PROJECT_ID=
